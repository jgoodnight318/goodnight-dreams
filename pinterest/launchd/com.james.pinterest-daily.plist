<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.james.pinterest-daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string><string>-lc</string>
    <string>set -a; source "$HOME/.config/pinterest.env"; set +a; cd "$HOME/Projects/goodnight_site/pinterest" && python3 pin.py --per-day 4</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key><string>/tmp/pinterest-daily.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/pinterest-daily.err.log</string>
</dict>
</plist>
