<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.james.automation-gigs</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>set -a; source "$HOME/.config/automation-gigs.env"; set +a; cd "$HOME/Projects/goodnight_site/automation-gigs" && python3 pipeline/intake.py</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/automation-gigs.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/automation-gigs.err.log</string>
</dict>
</plist>
