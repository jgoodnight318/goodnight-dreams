{
  "actorSpecification": 1,
  "name": "google-play-reviews",
  "title": "Google Play Reviews Scraper (Android)",
  "description": "Get the latest customer reviews, ratings and app metadata for any Android app on Google Play by package ID or by searching its name, across any country storefront. Clean JSON, no login, no proxies needed.",
  "version": "0.1",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Reviews",
      "fields": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Record type: review or app",
            "example": "review"
          },
          "appId": {
            "type": "string",
            "description": "Android package name of the app",
            "example": "com.whatsapp"
          },
          "country": {
            "type": "string",
            "description": "Two-letter Play Store country code",
            "example": "us"
          },
          "reviewId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stable review ID for deduplication (review records only)"
          },
          "rating": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Star rating 1-5 (review records only)",
            "example": 5
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Review title (Google Play reviews have no title; always null)"
          },
          "content": {
            "type": [
              "string",
              "null"
            ],
            "description": "Review text (review records only)"
          },
          "author": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reviewer's display name (review records only)"
          },
          "thumbsUp": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Number of users who found the review helpful (review records only)"
          },
          "reviewCreatedVersion": {
            "type": [
              "string",
              "null"
            ],
            "description": "App version the review refers to (review records only)"
          },
          "at": {
            "type": [
              "string",
              "null"
            ],
            "description": "Review timestamp, ISO 8601 (review records only)"
          },
          "replyContent": {
            "type": [
              "string",
              "null"
            ],
            "description": "Developer's reply text, if any (review records only)"
          },
          "repliedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "Developer reply timestamp, ISO 8601, if any (review records only)"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "App name (app records only)"
          },
          "developer": {
            "type": [
              "string",
              "null"
            ],
            "description": "Developer name (app records only)"
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "description": "Average user rating (app records only)"
          },
          "ratings": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Total rating count (app records only)"
          },
          "installs": {
            "type": [
              "string",
              "null"
            ],
            "description": "Install count bucket, e.g. '10,000,000,000+' (app records only)"
          },
          "price": {
            "type": [
              "number",
              "null"
            ],
            "description": "App price (app records only)"
          },
          "currency": {
            "type": [
              "string",
              "null"
            ],
            "description": "Price currency (app records only)"
          },
          "currentVersion": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest app version (app records only)"
          },
          "genre": {
            "type": [
              "string",
              "null"
            ],
            "description": "App category/genre (app records only)"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Play Store URL (app records only)"
          }
        },
        "required": [
          "type",
          "appId",
          "country"
        ]
      },
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "appId",
              "country",
              "rating",
              "content",
              "author",
              "at",
              "thumbsUp"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "rating": {
                "label": "Rating",
                "format": "number"
              },
              "content": {
                "label": "Review"
              },
              "author": {
                "label": "Author"
              },
              "at": {
                "label": "Date",
                "format": "date"
              },
              "thumbsUp": {
                "label": "Thumbs up",
                "format": "number"
              }
            }
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}